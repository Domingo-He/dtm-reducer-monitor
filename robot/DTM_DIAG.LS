/PROG  DTM_DIAG
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "J2 J3 J4 E1 FRICTION DIAG";
PROG_SIZE	= 0;
CREATE		= DATE 26-10-16  TIME 00:00:00;
MODIFIED	= DATE 26-10-16  TIME 00:00:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 0;
MEMORY_SIZE	= 0;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/MN
   1:  !Disturbance torque diag run ;
   2:  !Run after warm-up, same payload ;
   3:  !R[110] segment code = ;
   4:  !axis*1000 + speed%*10 + dir ;
   5:  !dir 1 = A->B (+), dir 2 = B->A ;
   6:  !axis 7 = travel axis E1 ;
   7:  !9900+axis = vibration window ;
   8:  !Teach PR[51..58] as JOINT, ;
   9:  !only the tested axis differs, ;
  10:  !B angle > A angle ;
  11:  OVERRIDE=100% ;
  12:  PAYLOAD[1] ;
  13:  R[110:DTM_SEG]=0    ;
  14:  R[111:DTM_RUN]=1    ;
  15:  J PR[50:DTM_HOME] 20% FINE    ;
  16:  !---- J2 ---- ;
  17:  J PR[51:J2_A] 20% FINE    ;
  18:  WAIT   1.00(sec) ;
  19:  R[110:DTM_SEG]=2051    ;
  20:  J PR[52:J2_B] 5% FINE    ;
  21:  R[110:DTM_SEG]=0    ;
  22:  WAIT    .50(sec) ;
  23:  R[110:DTM_SEG]=2052    ;
  24:  J PR[51:J2_A] 5% FINE    ;
  25:  R[110:DTM_SEG]=0    ;
  26:  WAIT    .50(sec) ;
  27:  R[110:DTM_SEG]=2101    ;
  28:  J PR[52:J2_B] 10% FINE    ;
  29:  R[110:DTM_SEG]=0    ;
  30:  WAIT    .50(sec) ;
  31:  R[110:DTM_SEG]=2102    ;
  32:  J PR[51:J2_A] 10% FINE    ;
  33:  R[110:DTM_SEG]=0    ;
  34:  WAIT    .50(sec) ;
  35:  R[110:DTM_SEG]=2201    ;
  36:  J PR[52:J2_B] 20% FINE    ;
  37:  R[110:DTM_SEG]=0    ;
  38:  WAIT    .50(sec) ;
  39:  R[110:DTM_SEG]=2202    ;
  40:  J PR[51:J2_A] 20% FINE    ;
  41:  R[110:DTM_SEG]=0    ;
  42:  WAIT    .50(sec) ;
  43:  J PR[50:DTM_HOME] 20% FINE    ;
  44:  !---- J3 ---- ;
  45:  J PR[53:J3_A] 20% FINE    ;
  46:  WAIT   1.00(sec) ;
  47:  R[110:DTM_SEG]=3051    ;
  48:  J PR[54:J3_B] 5% FINE    ;
  49:  R[110:DTM_SEG]=0    ;
  50:  WAIT    .50(sec) ;
  51:  R[110:DTM_SEG]=3052    ;
  52:  J PR[53:J3_A] 5% FINE    ;
  53:  R[110:DTM_SEG]=0    ;
  54:  WAIT    .50(sec) ;
  55:  R[110:DTM_SEG]=3101    ;
  56:  J PR[54:J3_B] 10% FINE    ;
  57:  R[110:DTM_SEG]=0    ;
  58:  WAIT    .50(sec) ;
  59:  R[110:DTM_SEG]=3102    ;
  60:  J PR[53:J3_A] 10% FINE    ;
  61:  R[110:DTM_SEG]=0    ;
  62:  WAIT    .50(sec) ;
  63:  R[110:DTM_SEG]=3201    ;
  64:  J PR[54:J3_B] 20% FINE    ;
  65:  R[110:DTM_SEG]=0    ;
  66:  WAIT    .50(sec) ;
  67:  R[110:DTM_SEG]=3202    ;
  68:  J PR[53:J3_A] 20% FINE    ;
  69:  R[110:DTM_SEG]=0    ;
  70:  WAIT    .50(sec) ;
  71:  J PR[50:DTM_HOME] 20% FINE    ;
  72:  !---- J4 ---- ;
  73:  !gearbox, optional: ;
  74:  !delete this block if J4 not used ;
  75:  J PR[55:J4_A] 20% FINE    ;
  76:  WAIT   1.00(sec) ;
  77:  R[110:DTM_SEG]=4051    ;
  78:  J PR[56:J4_B] 5% FINE    ;
  79:  R[110:DTM_SEG]=0    ;
  80:  WAIT    .50(sec) ;
  81:  R[110:DTM_SEG]=4052    ;
  82:  J PR[55:J4_A] 5% FINE    ;
  83:  R[110:DTM_SEG]=0    ;
  84:  WAIT    .50(sec) ;
  85:  R[110:DTM_SEG]=4101    ;
  86:  J PR[56:J4_B] 10% FINE    ;
  87:  R[110:DTM_SEG]=0    ;
  88:  WAIT    .50(sec) ;
  89:  R[110:DTM_SEG]=4102    ;
  90:  J PR[55:J4_A] 10% FINE    ;
  91:  R[110:DTM_SEG]=0    ;
  92:  WAIT    .50(sec) ;
  93:  R[110:DTM_SEG]=4201    ;
  94:  J PR[56:J4_B] 20% FINE    ;
  95:  R[110:DTM_SEG]=0    ;
  96:  WAIT    .50(sec) ;
  97:  R[110:DTM_SEG]=4202    ;
  98:  J PR[55:J4_A] 20% FINE    ;
  99:  R[110:DTM_SEG]=0    ;
 100:  WAIT    .50(sec) ;
 101:  J PR[50:DTM_HOME] 20% FINE    ;
 102:  !---- E1 ---- ;
 103:  !travel axis E1, optional: ;
 104:  !delete this block if no E1 ;
 105:  !PR[57]/PR[58]: same arm pose, ;
 106:  !only E1 position differs ;
 107:  J PR[57:E1_A] 20% FINE    ;
 108:  WAIT   1.00(sec) ;
 109:  R[110:DTM_SEG]=7051    ;
 110:  J PR[58:E1_B] 5% FINE    ;
 111:  R[110:DTM_SEG]=0    ;
 112:  WAIT    .50(sec) ;
 113:  R[110:DTM_SEG]=7052    ;
 114:  J PR[57:E1_A] 5% FINE    ;
 115:  R[110:DTM_SEG]=0    ;
 116:  WAIT    .50(sec) ;
 117:  R[110:DTM_SEG]=7101    ;
 118:  J PR[58:E1_B] 10% FINE    ;
 119:  R[110:DTM_SEG]=0    ;
 120:  WAIT    .50(sec) ;
 121:  R[110:DTM_SEG]=7102    ;
 122:  J PR[57:E1_A] 10% FINE    ;
 123:  R[110:DTM_SEG]=0    ;
 124:  WAIT    .50(sec) ;
 125:  R[110:DTM_SEG]=7201    ;
 126:  J PR[58:E1_B] 20% FINE    ;
 127:  R[110:DTM_SEG]=0    ;
 128:  WAIT    .50(sec) ;
 129:  R[110:DTM_SEG]=7202    ;
 130:  J PR[57:E1_A] 20% FINE    ;
 131:  R[110:DTM_SEG]=0    ;
 132:  WAIT    .50(sec) ;
 133:  J PR[50:DTM_HOME] 20% FINE    ;
 134:  !---- vibration window, optional ---- ;
 135:  !Only for battery wireless sensors ;
 136:  !that sample every 60 s. Delete if ;
 137:  !sensors are wired (IO-Link/Modbus). ;
 138:  !R[110]=9900+axis while moving ;
 139:  J PR[51:J2_A] 20% FINE    ;
 140:  R[110:DTM_SEG]=9902    ;
 141:  FOR R[115:DTM_I]=1 TO 6 ;
 142:  J PR[52:J2_B] 10% FINE    ;
 143:  J PR[51:J2_A] 10% FINE    ;
 144:  ENDFOR ;
 145:  R[110:DTM_SEG]=0    ;
 146:  J PR[53:J3_A] 20% FINE    ;
 147:  R[110:DTM_SEG]=9903    ;
 148:  FOR R[115:DTM_I]=1 TO 6 ;
 149:  J PR[54:J3_B] 10% FINE    ;
 150:  J PR[53:J3_A] 10% FINE    ;
 151:  ENDFOR ;
 152:  R[110:DTM_SEG]=0    ;
 153:  J PR[50:DTM_HOME] 20% FINE    ;
 154:  R[111:DTM_RUN]=0    ;
/POS
/END
